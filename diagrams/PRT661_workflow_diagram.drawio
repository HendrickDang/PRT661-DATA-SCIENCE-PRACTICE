      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PRT661 Dan2, Theme 2: End-to-End Analytics Workflow&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Forecasting assault rates across NT regions to support PFES resource planning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="12" width="1324" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ph0" value="&lt;b&gt;1. Acquire and Ingest&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=top;fontSize=12;fontStyle=1;dashed=0;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="72" width="244" height="322" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Source raw files&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;NT Open Data Portal: crime, population ERP, alcohol PAC&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Will, Thomas&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="54" y="112" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Ingest and validate schema&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;pandas; dtype, region and date checks&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Will&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="54" y="204" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Version-controlled data store&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;GitHub repo, dataset/source&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Will&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="54" y="296" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ph1" value="&lt;b&gt;2. Clean and Integrate&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=top;fontSize=12;fontStyle=1;dashed=0;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="310" y="72" width="244" height="322" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Clean and harmonise&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;region names, date parsing, missing values&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Emma&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="324" y="112" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Align temporal grain&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;annual ERP and quarterly PAC to monthly&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Emma&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="324" y="204" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Build monthly region panel&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;assault rate per 100,000 residents&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Emma&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="324" y="296" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ph2" value="&lt;b&gt;3. Feature and Split&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=top;fontSize=12;fontStyle=1;dashed=0;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="580" y="72" width="244" height="322" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Feature engineering&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;lags, rolling means, seasonal terms&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick; Thomas review&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="594" y="112" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. Assemble feature variants&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;V1 to V4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="594" y="204" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;9. Chronological split&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;train up to 2022 | test 2023-2025 held out&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="594" y="296" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ph3" value="&lt;b&gt;4. Model and Evaluate&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=top;fontSize=12;fontStyle=1;dashed=0;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="850" y="72" width="244" height="414" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="&lt;b&gt;10. Model selection on training CV&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;scaler inside Pipeline, refits on each fold&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="864" y="112" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="&lt;b&gt;11. Fit candidate models&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Linear, Ridge 0.1, Lasso 0.01, XGBoost (Thomas)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick, Thomas&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="864" y="204" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="&lt;b&gt;12. Rolling-origin backtest&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;h = 1, 3, 6, 12 vs seasonal naive and MA(12)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="864" y="296" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="&lt;b&gt;13. Select split specification&lt;/b&gt;&lt;div&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;XGBoost at h = 1, MA(12) at h of 3 or more&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;Owner: Hendrick&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" parent="1" vertex="1">
